{
  "name": "@eufemia/illustrations",
  "version": "0.0.0-development",
  "description": "Foundation-based illustrations maintained by Eufemia",
  "license": "SEE LICENSE IN LICENSE FILE",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnbexperience/illustrations.git"
  },
  "files": [
    "dist",
    "styles",
    "manifest.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./styles.css": "./styles/illustrations.css",
    "./manifest": "./manifest.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run check:generated && npm run build && npm run validate && npm run site:check && npm run pack:check",
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/generate.ts --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test 'tests/*.test.ts' 'tests/*.test.tsx'",
    "validate": "tsx scripts/validate.ts",
    "site": "tsx scripts/generate-site.ts",
    "dev": "tsx scripts/prepare-site.ts && vite --config vite.site.config.ts --host 127.0.0.1",
    "site:check": "npm run site && tsx scripts/check-site.ts",
    "pack:check": "tsx scripts/check-package.ts",
    "release:check": "npm publish --dry-run --tag=release-validation --provenance=false --registry=https://registry.npmjs.org/",
    "sync:figma": "tsx scripts/sync-figma.ts",
    "prepack": "npm run check:generated && npm run build",
    "test:browser": "playwright test",
    "preview": "tsx scripts/generate-site.ts --review",
    "discover:figma": "tsx scripts/discover-figma.ts",
    "import:figma": "tsx scripts/import-figma.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@dnb/eufemia": "^11.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.6.2",
    "purgecss": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.97.3",
    "semantic-release": "^25.0.9",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "8.3.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "v${version}",
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/npm",
        {
          "npmPublish": true
        }
      ],
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failCommentCondition": false
        }
      ]
    ]
  }
}
